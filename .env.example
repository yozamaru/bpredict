# ===== batch/ =====
# 値は GitHub Secrets で管理する。このファイルに実値を書かない
INGEST_TOKEN=
API_BASE_URL=https://<worker>.workers.dev

# ===== api/ （.dev.vars に置く） =====
# INGEST_TOKEN=dev
# INGEST_TOKEN_NEXT=
# FINALIZE_TOKEN=dev

# ===== web/ （.env.local に置く） =====
# NEXT_PUBLIC_API_BASE=http://127.0.0.1:8787

# ===== マイグレーション専用 =====
# スコープは対象 D1 の Edit のみに絞る
CF_API_TOKEN=
CF_ACCOUNT_ID=
# D1_DATABASE_ID は機密ではないため wrangler.toml に直書きしてよい
