{
  "name": "bpredict-web",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:tokens": "node scripts/check-contrast.mjs",
    "test:budget": "node scripts/check-js-budget.mjs",
    "test:links": "node scripts/check-links.mjs",
    "test:nav": "node scripts/check-nav.mjs",
    "test:bar": "node scripts/check-bar.mjs",
    "test:notes": "node scripts/check-notes.mjs",
    "test:disclaimer": "node scripts/check-disclaimer.mjs",
    "test:unit": "node --test \"lib/__tests__/*.test.ts\""
  },
  "dependencies": {
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "wrangler": "^4.144.0"
  }
